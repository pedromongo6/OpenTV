<?xml version="1.0" encoding="utf-8"?>
<!-- file: res/layout/dialog_add_source.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/fieldName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_name"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_host"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_user"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/field_pass"
            android:inputType="textPassword"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/fieldError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F44336"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
